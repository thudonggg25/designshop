    "R01": {
      "name": "Brightness rule",
      "value": "use B03 sparingly",
      "text": "At most one large B03 block per screen (the main card). Otherwise B03 only appears on switches that are on, progress bars, status dots and active icon tiles. Text on a B03 block uses ink M0 #0D1D2A."
    },
    "R02": {
      "name": "One accent",
      "value": "don't mix accents",
      "text": "Each screen uses one main accent color. Other B colors are only for secondary states."
    },
    "R03": {
      "name": "Background hierarchy",
      "text": "The higher a layer sits, the lighter its background: N0 app background, N1 surface, N2 card, N3 icon tile inside a card."
    },
    "R04": {
      "name": "3-level hierarchy",
      "value": "headline > subhead > CTA",
      "text": "Every KV has exactly 3 reading levels: the largest headline (read in 1 second), a subhead at least 2 type steps smaller, and a CTA that stands out in the accent color."
    },
    "R05": {
      "name": "Safe area",
      "value": "keep 5–8% margins",
      "text": "Keep text and logo at least 5–8% of the short side away from the edges. Stories/Reels keep 250px clear top and bottom. Facebook covers keep key content in the central 820px."
    },
    "R06": {
      "name": "Text contrast",
      "value": "at least 4.5:1",
      "text": "Body text needs at least 4.5:1 contrast with its background; large text over 24px at least 3:1. Text over photos needs a dark overlay or a solid block."
    },
    "R07": {
      "name": "Max 2 fonts",
      "value": "1 heading + 1 body",
      "text": "Use at most 2 font families: one for headings, one for body. Create contrast with size and weight instead of adding fonts."
    },
    "R08": {
      "name": "60-30-10 color ratio",
      "value": "dominant · secondary · accent",
      "text": "60% dominant color (background), 30% secondary (blocks, imagery), 10% accent (CTA, highlights). Use the accent only for the most important thing."
    },
    "R09": {
      "name": "Logo & identity",
      "value": "fixed corner, enough breathing room",
      "text": "Place the logo in one fixed corner (usually top-left or bottom-right), about 8–12% of the width, with clear space around it equal to the cap height."
    },
    "R10": {
      "name": "One main idea",
      "value": "one message, one focal point",
      "text": "Each KV carries one main message and has one first focal point. Secondary information goes in the caption or landing page."
    },
    "R11": {
      "name": "Vietnamese text",
      "value": "pick fonts with accents",
      "text": "Only use fonts with full Vietnamese accent support for accented text. Check ư, ơ, ặ, ỗ, ữ before locking the font."
    }
